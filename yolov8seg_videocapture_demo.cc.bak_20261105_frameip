// 线程安全队列模板
template <typename T>
class SafeQueue
{
private:
    std::queue<T> queue_;
    mutable std::mutex mutex_;
    std::condition_variable cond_;

public:
    SafeQueue() = default;
    ~SafeQueue() = default;

    void push(const T &item)
    {
        std::lock_guard<std::mutex> lock(mutex_);
        queue_.push(item);
        cond_.notify_one();
    }

    bool pop(T &item, int timeout_ms = -1)
    {
        std::unique_lock<std::mutex> lock(mutex_);

        if (timeout_ms < 0)
        {
            cond_.wait(lock, [this]
                       { return !queue_.empty() || !running; });
        }
        else
        {
            if (!cond_.wait_for(lock, std::chrono::milliseconds(timeout_ms),
                                [this]
                                { return !queue_.empty() || !running; }))
            {
                return false;
            }
        }

        if (!running)
            return false;

        item = queue_.front();
        queue_.pop();
        return true;
    }

    size_t size() const
    {
        std::lock_guard<std::mutex> lock(mutex_);
        return queue_.size();
    }

    bool empty() const
    {
        std::lock_guard<std::mutex> lock(mutex_);
        return queue_.empty();
    }

    // 添加清空队列的方法
    void clear()
    {
        std::lock_guard<std::mutex> lock(mutex_);
        while (!queue_.empty())
        {
            queue_.pop();
        }
    }
};

