// 拟合轮廓为圆，返回圆心和半径
bool fit_contour_to_circle(const std::vector<ContourPoint> &contour, cv::Point2f &center, float &radius)
{
    if (contour.size() < 5)
    { // 至少需要5个点才能拟合圆
        return false;
    }
    // std::vector<ContourPoint> points
    std::vector<cv::Point> points = convert_to_cv_points(contour);
